# Hosted OpenAI-compatible provider credentials (keep the real .env private).
OPENAI_API_KEY=your-server-side-provider-key
LLM_MODEL=gpt-4.1-mini

# Optional: use an OpenAI-compatible local server such as Ollama.
# When set, OPENAI_API_KEY may be omitted (a placeholder is used server-side).
# OPENAI_BASE_URL=http://localhost:11434/v1

# Exact browser origins allowed to call the API. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
